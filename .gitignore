# desktop run kit: the jlink'd runtime bundled into the Electron app (build artifact)
spectro-desktop/jre/
# desktop run kit: llama.cpp's llama-server + dylib closure, fetched and sha256-pinned
# by scripts/fetch-llama-server.sh (build artifact, 22 MB, never committed)
spectro-desktop/bin/
# Linux run kit staging (card 134): OS/arch-suffixed so a Linux build can never
# contaminate the macOS dirs above — scripts/build-linux-runkit.sh
spectro-desktop/jre-linux-x64/
spectro-desktop/bin-linux-x64/
# Eclipse/JDT compiles the Gradle modules into a sibling bin/ of its own. Gradle
# builds into build/, so these are a second copy of the same output and five of
# them reached main before anyone looked.
spectro-core/bin/
spectro-cli/bin/
spectro-orchestrator/bin/
spectro-server/bin/
spectro-mcp-notes/bin/
# Jenkins durable-task scratch. The agent bind-mounts the real working tree, and
# every dir() it enters gets a SIBLING <path>@tmp written next to it from inside
# a Linux container (card 180). Three of those files were committed by PR #53.
*@tmp/
.gradle/
.kotlin/
.DS_Store
.obsidian/
.claude/

# Machine-local: each machine sets its own MCP server paths (absolute).
.spectro/settings.json
# Machine-local overrides next to any checked-in project settings.
.spectro/settings.local.json

# IDE project folders (machine-local)
.idea/
.vscode/
*.iml
.run/
logs/

# graphify AST-cache droppings (knowledge-graph tooling in the product home)
graphify-out/

# the guide generator caches its lossless WebP re-encodes here; the PNG
# masters in shots/ and shots-light/ are the tracked source of truth
docs/guide-assets/.webp-cache/

# the guide is photographed against a curated home (demo-home/README.md);
# the server regenerates these on every boot, only sessions/ + settings.json are ours
docs/guide-assets/demo-home/.spectro/logs/
docs/guide-assets/demo-home/.spectro/skills/
docs/guide-assets/demo-home/.spectro/leveling.json
docs/guide-assets/demo-home/.spectro/sessions-index.json

# a capture run leaves its live sessions in the demo home; the seven curated
# ones are tracked, everything the run adds is byproduct (see demo-home/README.md)
docs/guide-assets/demo-home/.spectro/llm-wire/
docs/guide-assets/demo-home/spectro-demo/
