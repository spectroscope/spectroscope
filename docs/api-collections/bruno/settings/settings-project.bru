meta {
  name: patch project settings
  type: http
  seq: 3
}

put {
  url: {{baseUrl}}/api/settings/project
  body: json
  auth: none
}

params:query {
  session: {{sessionId}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "provider": "ollama"
  }
}

docs {
  Patch the session workspace's .spectro/settings.json; answers the fresh session-moment view.
  
  Body: Flat JSON patch.
  
  Fence: host+origin — Loopback fence plus Origin check: an Origin header, if present, must be loopback. REST clients send no Origin header, which counts as safe — requests pass. A manually added foreign Origin answers a blank 404.
  
  Writes state: yes
}
