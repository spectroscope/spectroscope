#!/usr/bin/env bash
# spectro-ci — the local CI laboratory, in the house launcher style.
#
# The owner: "ich würde gerne concourse und jenkins nehmen. also beides parallel
# und ich schalte einfach irgendwo um was ich nehmen will zum vergleich" — plus
# SonarQube, Dependency-Track and a dependency updater, "zum testen ich will ja
# alles wissen". Later, and for the same reason: "im docker setup ein search
# ordner machen und dann SearXNG also docker option mit rein nehmen zum starten"
# — "neben build deploy und so", so a search engine you host yourself gets
# started and stopped like every other tool here.
#
# So: one command, six stacks, each its own compose project on its own ports,
# started and stopped independently.
#
#   ./ci/spectro-ci up jenkins          one stack
#   ./ci/spectro-ci up concourse sonar  two
#   ./ci/spectro-ci up all              everything (see MEMORY below)
#   ./ci/spectro-ci status              what is running, and on which port
#   ./ci/spectro-ci logs jenkins -f
#   ./ci/spectro-ci down all
#   ./ci/spectro-ci open sonar
#   ./ci/spectro-ci doctor              is this machine able to run them
#
# ⚠️ MEMORY IS THE BINDING CONSTRAINT, not CPU. Measured on this machine on
# 2026-08-05: Docker Desktop had 7.7 GiB of the host's 48 GiB. SonarQube alone
# wants ~4 GiB for its embedded Elasticsearch and Dependency-Track's API server
# is a JVM that asks for 4 GiB. `up all` will not fit in 7.7 GiB. Either raise
# Docker Desktop's memory (Settings → Resources → Memory; 16 GiB is comfortable)
# or bring stacks up two at a time — which is what the per-stack switch is for.
#
# ⚠️ AND THE ONE THING NO CONTAINER HERE CAN DO: sign the DMG. Docker on macOS is
# a Linux VM; codesign, notarytool, stapler and hdiutil need the macOS host and
# its keychain. Everything else in the release — both gates, the jar, the CLI
# zip, the Linux kit, the SBOM, the Sonar scan — runs in these containers. That
# one leg needs an agent on the host, and konzept/BUILD-SERVER.md says what that
# costs.
set -u
cd "$(dirname "$0")" || exit 1
CI_DIR="$PWD"
REPO="$(cd .. && pwd)"

# ------------------------------- THE STACKS -----------------------------------
# name|directory|host port|url path|what it is
# Ports avoid everything measured listening on this machine on 2026-08-05 —
# notably 9000 (SonarQube's own default) and 8080, both already taken.
STACKS=(
  "concourse|concourse|8880|/|the flow-shaped one — pipelines as YAML, every step a container"
  "jenkins|jenkins|8881|/|a controller AND a separate agent node, so the split is visible"
  "sonar|sonarqube|8882|/|static analysis over Java and TypeScript"
  "deptrack|dependency-track|8883|/|what our dependencies are made of, from an SBOM"
  "search|search|8885|/|a private SearXNG that answers JSON, not just a search page"
  "renovate|renovate|0|-|dependency updates, run on demand — no server, no port"
)

stack_field() { # name field-index -> value
  local n=$1 f=$2 row
  for row in "${STACKS[@]}"; do
    [ "${row%%|*}" = "$n" ] || continue
    printf '%s' "$(printf '%s' "$row" | cut -d'|' -f"$f")"
    return 0
  done
  return 1
}
stack_names() { local row; for row in "${STACKS[@]}"; do printf '%s\n' "${row%%|*}"; done; }

# ------------------------------- COLOUR ---------------------------------------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  C_CY=$'\033[38;5;51m'; C_VI=$'\033[38;5;141m'; C_OK=$'\033[38;5;42m'
  C_WA=$'\033[38;5;214m'; C_ER=$'\033[38;5;203m'; C_DIM=$'\033[2m'; C_B=$'\033[1m'; C_0=$'\033[0m'
else
  C_CY=""; C_VI=""; C_OK=""; C_WA=""; C_ER=""; C_DIM=""; C_B=""; C_0=""
fi
say() { printf '%s\n' "$*"; }
ok()  { printf '%s✓%s %s\n' "$C_OK" "$C_0" "$*"; }
warn(){ printf '%s!%s %s\n' "$C_WA" "$C_0" "$*"; }
err() { printf '%s✗%s %s\n' "$C_ER" "$C_0" "$*" >&2; }

banner() {
  printf '%s\n' "${C_CY}  ┌─────────────────────────────────────────────┐${C_0}"
  printf '%s\n' "${C_CY}  │${C_0}  ${C_B}spectro-ci${C_0} ${C_DIM}· the local build laboratory${C_0}   ${C_CY}│${C_0}"
  printf '%s\n' "${C_CY}  └─────────────────────────────────────────────┘${C_0}"
}

# ------------------------------- DOCKER ---------------------------------------
# `open -a Docker` returns -1712 (an AppleEvent timeout) while starting the app
# perfectly well, so its exit code says nothing. Wait for `docker info` instead —
# the v0.6.0 release lesson, written down in CLAUDE.md.
require_docker() {
  if docker info >/dev/null 2>&1; then return 0; fi
  warn "the Docker daemon is not running — starting Docker Desktop"
  open -a Docker >/dev/null 2>&1 || true
  local i
  for i in $(seq 1 60); do
    docker info >/dev/null 2>&1 && { ok "docker is up"; return 0; }
    sleep 2
  done
  err "docker did not come up within two minutes"
  return 1
}

compose() { # stack-dir args...
  local dir=$1; shift
  ( cd "$CI_DIR/$dir" && REPO_DIR="$REPO" docker compose "$@" )
}

# ------------------------------- COMMANDS -------------------------------------
resolve() { # arg -> stack names, one per line ("all" expands)
  if [ "$1" = "all" ]; then stack_names; return; fi
  if stack_field "$1" 1 >/dev/null 2>&1; then printf '%s\n' "$1"; return; fi
  err "unknown stack: $1"
  say "known: $(stack_names | tr '\n' ' ')all"
  return 1
}

cmd_up() {
  [ $# -gt 0 ] || { err "which stack? try: $(stack_names | tr '\n' ' ')all"; return 1; }
  require_docker || return 1
  local name dir port
  for arg in "$@"; do
    while read -r name; do
      [ -n "$name" ] || continue
      dir=$(stack_field "$name" 2); port=$(stack_field "$name" 3)
      say ""
      printf '%s%s%s  %s\n' "$C_B" "$name" "$C_0" "$(stack_field "$name" 5)"
      if [ ! -f "$CI_DIR/$dir/docker-compose.yml" ]; then
        warn "$dir/docker-compose.yml is not there yet"
        continue
      fi
      # Concourse cannot start without its three keypairs, and the error it
      # gives when they are missing does not say so.
      if [ "$name" = "concourse" ]; then "$CI_DIR/concourse/generate-keys.sh" || return 1; fi
      # SearXNG starts either way — and answers 403 to every API call until its
      # settings file lists `json`, which is the difference between a page you
      # can browse and an instance a client can query. The script writes it.
      if [ "$name" = "search" ]; then "$CI_DIR/search/generate-settings.sh" || return 1; fi
      # --build, always. Without it a changed Dockerfile or plugins.txt is
      # silently ignored and you debug the OLD image — which cost two rounds
      # here before it was noticed. Docker's layer cache makes the no-change
      # case nearly free, so there is no reason to guess.
      compose "$dir" up -d --build || { err "$name did not come up"; continue; }
      if [ "$port" != "0" ]; then
        printf '   %s→%s http://localhost:%s%s\n' "$C_VI" "$C_0" "$port" "$(stack_field "$name" 4)"
      fi
    done <<< "$(resolve "$arg")" || return 1
  done
  say ""
  say "${C_DIM}first boot takes a while — sonar and deptrack build a database.${C_0}"
  say "${C_DIM}./ci/spectro-ci status  says when each is answering.${C_0}"
}

cmd_down() {
  [ $# -gt 0 ] || { err "which stack? or: down all"; return 1; }
  require_docker || return 1
  local name dir
  for arg in "$@"; do
    while read -r name; do
      [ -n "$name" ] || continue
      dir=$(stack_field "$name" 2)
      [ -f "$CI_DIR/$dir/docker-compose.yml" ] || continue
      say "stopping $name …"
      compose "$dir" down
    done <<< "$(resolve "$arg")" || return 1
  done
}

# A stack is UP when its port answers at all — any HTTP status. A 403 from a
# Jenkins that has not finished starting is still "listening", and saying
# "down" there sends a reader looking for a problem that does not exist.
answers() { curl -s -o /dev/null -m 2 "http://localhost:$1$2"; }

cmd_status() {
  banner
  require_docker || return 1
  printf '\n  %-11s %-7s %-9s %s\n' "STACK" "PORT" "STATE" "CONTAINERS"
  local name dir port path n state
  while read -r name; do
    dir=$(stack_field "$name" 2); port=$(stack_field "$name" 3); path=$(stack_field "$name" 4)
    n=0
    if [ -f "$CI_DIR/$dir/docker-compose.yml" ]; then
      n=$(compose "$dir" ps -q 2>/dev/null | grep -c . || true)
    fi
    if [ "$n" = "0" ]; then state="${C_DIM}down${C_0}"
    elif [ "$port" = "0" ]; then state="${C_OK}ready${C_0}"
    elif answers "$port" "$path"; then state="${C_OK}up${C_0}"
    else state="${C_WA}starting${C_0}"; fi
    # NOT ${port/0/—}: that replaces the first 0 ANYWHERE, so 8880 printed as
    # "888—". A stack with no web face is the literal string "0", nothing else.
    local shown="$port"; [ "$port" = "0" ] && shown="—"
    printf '  %-11s %-7s %-20s %s\n' "$name" "$shown" "$state" "$n"
  done <<< "$(stack_names)"
  say ""
  local mem
  mem=$(docker system info --format '{{.MemTotal}}' 2>/dev/null || echo 0)
  if [ "$mem" -gt 0 ] 2>/dev/null; then
    printf '  %sdocker memory: %.1f GiB%s\n' "$C_DIM" "$(echo "$mem" | awk '{print $1/1073741824}')" "$C_0"
    if [ "$mem" -lt 12884901888 ]; then
      printf '  %sunder 12 GiB — sonar and deptrack together will not fit. Raise it in%s\n' "$C_WA" "$C_0"
      printf '  %sDocker Desktop → Settings → Resources, or bring stacks up in pairs.%s\n' "$C_WA" "$C_0"
    fi
  fi
}

cmd_logs() {
  [ $# -gt 0 ] || { err "which stack?"; return 1; }
  local name=$1; shift
  local dir; dir=$(stack_field "$name" 2) || { err "unknown stack: $name"; return 1; }
  compose "$dir" logs "$@"
}

cmd_open() {
  local name=${1:-}
  [ -n "$name" ] || { err "which stack?"; return 1; }
  local port; port=$(stack_field "$name" 3) || { err "unknown stack: $name"; return 1; }
  [ "$port" != "0" ] || { warn "$name has no web face"; return 0; }
  open "http://localhost:$port$(stack_field "$name" 4)"
}

cmd_doctor() {
  banner
  say ""
  local bad=0
  if docker info >/dev/null 2>&1; then ok "docker daemon is running"
  else err "docker daemon is not running — open Docker Desktop"; bad=1; fi

  local arch; arch=$(docker version --format '{{.Server.Arch}}' 2>/dev/null || echo "?")
  if [ "$arch" = "arm64" ]; then ok "docker is arm64 — images without an arm64 manifest will emulate and crawl"
  else warn "docker arch is $arch"; fi

  local mem; mem=$(docker system info --format '{{.MemTotal}}' 2>/dev/null || echo 0)
  if [ "$mem" -ge 12884901888 ] 2>/dev/null; then ok "docker memory is enough for two heavy stacks"
  else warn "docker memory is under 12 GiB — run stacks in pairs, or raise it"; fi

  local p
  for p in 8880 8881 8882 8883 8884 8885 50000; do
    if lsof -nP -iTCP:"$p" -sTCP:LISTEN >/dev/null 2>&1; then
      warn "port $p is already taken"; bad=1
    fi
  done
  [ "$bad" = "0" ] && ok "every port this needs is free"

  if command -v fly >/dev/null 2>&1; then ok "fly (the Concourse CLI) is installed"
  else warn "fly is not installed — brew install --cask fly, or skip Concourse"; fi

  say ""
  [ "$bad" = "0" ] && ok "ready" || warn "see the lines above"
}

cmd_help() {
  banner
  cat <<'USAGE'

  up <stack…|all>      bring stacks up
  down <stack…|all>    take them down
  status               what is running, on which port, and whether it answers
  logs <stack> [-f]    follow one stack's logs
  open <stack>         open its web face
  doctor               can this machine run them

  STACKS
USAGE
  local row
  for row in "${STACKS[@]}"; do
    printf '    %s%-11s%s %-6s %s\n' "$C_B" "$(printf '%s' "$row" | cut -d'|' -f1)" "$C_0" \
      "$(printf '%s' "$row" | cut -d'|' -f3 | sed 's/^0$/—/')" \
      "$(printf '%s' "$row" | cut -d'|' -f5)"
  done
  cat <<'TAIL'

  Everything writes into named volumes, so `down` keeps your data and
  `down -v` (via docker compose directly) is the one that forgets it.
TAIL
}

case "${1:-}" in
  up)     shift; cmd_up "$@" ;;
  down)   shift; cmd_down "$@" ;;
  status) cmd_status ;;
  logs)   shift; cmd_logs "$@" ;;
  open)   shift; cmd_open "$@" ;;
  doctor) cmd_doctor ;;
  help|-h|--help) cmd_help ;;
  "")     cmd_status; say ""; say "${C_DIM}./ci/spectro-ci help  for the rest${C_0}" ;;
  *)      err "unknown command: $1"; cmd_help; exit 1 ;;
esac
